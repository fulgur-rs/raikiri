# [doc = ""]
# [doc = " CSS Compositing 1 §3.4.2"]
# [non_exhaustive]
# [derive (Clone , Copy , Debug , PartialEq , Eq)]
pub enum Isolation {
    # [doc = " `auto`"]
    Auto ,
    # [doc = " `isolate`"]
    Isolate ,
}
impl Isolation {
    # [doc = r" Every keyword, in declaration order."]
    # [cfg (test)]
    pub (crate) const ALL : & 'static [Self] = & [Self :: Auto , Self :: Isolate] ;
    # [doc = r" This keyword's CSS spelling."]
    pub const fn as_css_str (self) -> & 'static str {
        let this = self ;
        match this {
            Self :: Auto => "auto" ,
            Self :: Isolate => "isolate" ,
        }
    }
    # [doc = r" Parses one keyword, ASCII case-insensitively."]
    pub (crate) fn from_css_ident (ident : & str) -> :: core :: option :: Option < Self > {
        :: cssparser :: match_ignore_ascii_case ! {
            ident ,
            "auto" => :: core :: option :: Option :: Some (Self :: Auto) ,
            "isolate" => :: core :: option :: Option :: Some (Self :: Isolate) ,
            _ => :: core :: option :: Option :: None ,
        }
    }
}

