# [doc = r" Serializes the computed value of the declared longhand `key`"]
# [doc = r" from `computed`, for CSSOM computed-style reads: the field is"]
# [doc = r" lifted back to its specified type (the identity when the entry"]
# [doc = r" has no computed type of its own) and serialized as"]
# [doc = r" `longhand_serialize` does. `None` for an entry without"]
# [doc = r" `serialize:` and for a key not declared in `properties!`."]
pub (crate) fn longhand_serialize_computed (key : PropertyKey , computed : & ComputedTable ,) -> :: core :: option :: Option < :: std :: string :: String > {
    match key {
        PropertyKey :: Isolation => longhand_serialize (& PropertyValue :: Isolation (< isolation :: Property as crate :: property :: Longhand > :: lift (:: core :: clone :: Clone :: clone (& computed . isolation)) ,)) ,
        PropertyKey :: WordSpacing => longhand_serialize (& PropertyValue :: WordSpacing (< spacing :: Property as crate :: property :: Longhand > :: lift (:: core :: clone :: Clone :: clone (& computed . spacing)) ,)) ,
        _ => :: core :: option :: Option :: None ,
    }
}
